# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_COMPAT_API_KEY: Optional API key for OpenAI-compatible AI endpoints
# (e.g., OpenAI, OpenRouter, Groq, DeepSeek, Together). Local endpoints like
# Ollama or LM Studio can run without an API key.
OPENAI_COMPAT_API_KEY="MY_OPENAI_COMPAT_API_KEY"

# OPENAI_COMPAT_BASE_URL: Default base URL for OpenAI-compatible endpoints.
OPENAI_COMPAT_BASE_URL="https://api.openai.com/v1"

# OPENAI_COMPAT_MODEL: Default model identifier for OpenAI-compatible endpoints.
OPENAI_COMPAT_MODEL="gpt-4o"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
