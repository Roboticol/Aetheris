{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aetheris",
  "version": "0.1.0",
  "identifier": "dev.aetheris.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aetheris",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0F1117",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "targets": ["appimage", "deb", "rpm", "msi", "nsis"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
